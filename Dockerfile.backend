# Sử dụng image Python 3.10 mỏng nhẹ
FROM python:3.10-slim

# Thiết lập thư mục làm việc
WORKDIR /app

# Cài đặt các thư viện hệ thống cần thiết cho OpenCV
RUN apt-get update && apt-get install -y \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Cài đặt uv (Package manager siêu tốc)
RUN pip install uv

# Copy file cấu hình pyproject.toml vào
COPY pyproject.toml .

# Cài đặt thư viện thông qua uv
RUN uv sync --all-extras --system

# Copy toàn bộ mã nguồn vào
COPY src/ src/
COPY configs/ configs/

# Expose port 8000
EXPOSE 8000

# Lệnh chạy server
CMD ["uvicorn", "vshield.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
